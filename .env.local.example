# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real credentials.

# Your Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (Settings → API → Project API keys → anon/public)
# IMPORTANT: This was previously committed with a real key — rotate it in the
# Supabase dashboard (Settings → API → Roll anon key) so the old value is
# invalidated, then paste your fresh key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq API key for AI features (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here