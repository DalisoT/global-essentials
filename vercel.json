{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/regenerate-forecasts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/detect-anomalies",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/sync-goal-progress",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/pre-order-updates",
      "schedule": "45 0 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/weekly-briefing",
      "schedule": "0 6 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/offline",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
